    "Tea", "Coffee", "Biscuits", "Chips","Pasta", "Oil", "Flour", "Salt", "Yogurt", "Butter",
    "Chicken", "Apples", "Bananas", "Oranges", "Tomatoes", "Potatoes", "Onions","Carrots",
    "Cucumber", "Lettuce", "Peppers", "Garlic", "Jam", "Honey", "Ketchup", "Mayonnaise",
    "Vinegar", "Tuna", "Sausage", "Beef", "Fish","Frozen Vegetables", "Ice Cream", "Cake",
    "Donuts","Con Flakes","Chocolate", "Soap", "Shampoo", "Toothpaste", "Tissues", "Detergent"
};
int prices[50] = { 35, 35, 50, 20, 15, 120, 100, 10, 90, 80, 30, 20, 35, 70, 35,
    45, 20, 120, 90, 80, 35, 25, 30, 15, 15, 10, 15, 20, 15, 35, 40, 60, 45, 70,
    55, 90, 55, 220, 150, 25, 40, 10, 50, 75, 100, 20, 100, 65, 35, 35
};
HWND AddLabel(
    HWND parent, const char* text, int x, int y, int width, int height
)
{
    return CreateWindowA(
        "STATIC",
        text, WS_VISIBLE | WS_CHILD, x, y, width, height, parent, NULL, NULL, NULL
    );
}
HWND AddButton(
    HWND parent, const char* text, int id, int x, int y, int width, int height
)
{
    return CreateWindowA(
        "BUTTON", text, WS_VISIBLE | WS_CHILD | BS_PUSHBUTTON, x, y, width,
        height, parent, (HMENU)id, NULL, NULL
    );
}
void UpdateCart() {
    SendMessageA(
        hCart,
        LB_RESETCONTENT,
        0,
        0
    );
    bool empty = true;
    for (int i = 0; i < 50; i++) {
        if (cartQuantity[i] > 0) {
            empty = false;
            stringstream ss;
            ss << products[i]
               << "   x"
               << cartQuantity[i]
               << "   = "
               << prices[i] * cartQuantity[i]
               << " EGP";
            SendMessageA(
                hCart,
                LB_ADDSTRING,
                0,
                (LPARAM)ss.str().c_str()
            );
        }
    }
    if (empty) {
        SendMessageA(
            hCart,
            LB_ADDSTRING,
            0,
            (LPARAM)"Your cart is empty"
        );
    }
}
void UpdateTotal() {
    stringstream ss;
    ss << "Grand Total: "
       << grandTotal
       << " EGP";
    SetWindowTextA(
        hTotal,
        ss.str().c_str()
    );
}
void CheckCredit(HWND hwnd) {
    if (grandTotal >= 1000 && creditWon == false){
        creditWon = true;
        stringstream ss;
        ss << "Congratulations!\n"
           << "Your total is "
           << grandTotal
           << " EGP.\n"
           << "You won 200 EGP Credit!";

        SetWindowTextA(
            hMessage,
            ss.str().c_str()
        );

        MessageBoxA(
            hwnd,
            "Congratulations!\n\n"
            "You reached 1000 EGP!\n\n"
            "You have won 200 EGP Credit!",
            "SPECIAL GIFT",
            MB_OK | MB_ICONINFORMATION
        );
    }
}
LRESULT CALLBACK WindowProcedure(
    HWND hwnd, UINT message, WPARAM wp, LPARAM lp
)
{
    switch (message) {
        case WM_CREATE: {
            AddLabel(
