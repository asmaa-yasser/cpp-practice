                );
            }
            AddLabel(
                hwnd,
                "SHOPPING CART",
                430,
                115,
                300,
                25
            );
            hCart = CreateWindowA(
                "LISTBOX",
                "",
                WS_VISIBLE |
                WS_CHILD |
                WS_BORDER |
                LBS_NOTIFY |
                WS_VSCROLL,
                430,
                140,
                330,
                140,
                hwnd,
                (HMENU)11,
                NULL,
                NULL
            );
            AddLabel(
                hwnd,
                "Product Number:",
                430,
                300,
                150,
                25
            );
            hProduct = CreateWindowA(
                "EDIT",
                "",
                WS_VISIBLE |
                WS_CHILD |
                WS_BORDER |
                ES_NUMBER,
                590,
                295,
                170,
                30,
                hwnd,
                (HMENU)20,
                NULL,
                NULL
            );
            AddLabel(
                hwnd,
                "Quantity:",
                430,
                345,
                150,
                25
            );
            hQuantity = CreateWindowA(
                "EDIT",
                "1",
                WS_VISIBLE |
                WS_CHILD |
                WS_BORDER |
                ES_NUMBER,
                590,
                340,
                170,
                30,
                hwnd,
                (HMENU)21,
                NULL,
                NULL
            );
            AddButton(
                hwnd,
                "ADD TO CART",
                100,
                430,
                390,
                330,
                45
            );
            AddButton(
                hwnd,
                "REMOVE ITEM",
                103,
                430,
                445,
                330,
                45
            );
            hTotal = AddLabel(
                hwnd,
                "Grand Total: 0 EGP",
                430,
                510,
                330,
                55
            );
            hMessage = AddLabel(
                hwnd,
                "Add products to start shopping!",
                430,
                575,
                330,
                70
            );
            AddLabel(
                hwnd,
                "CUSTOMER INFORMATION",
                35,
                550,
                330,
                30
            );
            AddLabel(
                hwnd,
                "Name:",
                35,
                605,
                75,
                30
            );
            hName = CreateWindowA(
                "EDIT",
                "",
                WS_VISIBLE |
                WS_CHILD |
                WS_BORDER,
                120,
                600,
                270,
                32,
                hwnd,
                (HMENU)40,
                NULL,
                NULL
            );
            AddLabel(
                hwnd,
                "Address:",
                35,
                650,
                75,
                30
            );
            hAddress = CreateWindowA(
                "EDIT",
                "",
                WS_VISIBLE |
                WS_CHILD |
                WS_BORDER,
                120,
                645,
                270,
                32,
                hwnd,
                (HMENU)41,
                NULL,
                NULL
            );
            AddButton(
                hwnd,
                "CHECKOUT",
                101,
                430,
                665,
                160,
                45
            );
            AddButton(
                hwnd,
                "CLEAR CART",
                102,
                600,
                665,
                160,
                45
            );
            UpdateCart();
            UpdateTotal();
            break;
        }
        case WM_COMMAND:{
            int id = LOWORD(wp);
            if (
                id == 10 &&
                HIWORD(wp) == LBN_SELCHANGE
            )
            {
                int selected =
                    SendMessageA(
                        hList,
                        LB_GETCURSEL,
                        0,
                        0
                    );
                if (selected != LB_ERR){
                    stringstream ss;
                    ss << selected + 1;
                    SetWindowTextA(
                        hProduct,
                        ss.str().c_str()
                    );
                    SetWindowTextA(
                        hQuantity,
                        "1"
                    );
                }
            }
            else if (id == 100){
                char productText[50];
                char quantityText[50];
                GetWindowTextA(
                    hProduct,
                    productText,
                    50
                );
                GetWindowTextA(
                    hQuantity,
                    quantityText,
                    50
                );
                int productNumber =
                    atoi(productText);
                int quantity =
                    atoi(quantityText);
                if (
                    productNumber < 1 ||
                    productNumber > 50
                )
                {
                    MessageBoxA(
                        hwnd,
                        "Please enter a valid product number (1 - 50).",
                        "Invalid Product",
                        MB_OK | MB_ICONWARNING
                    );
                    break;
                }
                if (quantity < 1) {
                    MessageBoxA(
                        hwnd,
                        "Quantity must be at least 1.",
                        "Invalid Quantity",
                        MB_OK | MB_ICONWARNING
                    );
                    break;
                }
                int index =
                    productNumber - 1;
                cartQuantity[index] += quantity;
                int itemTotal =
                    prices[index] * quantity;
                grandTotal += itemTotal;
                UpdateCart();
                UpdateTotal();
                stringstream messageText;
                messageText
                    << products[index]
                    << " x"
                    << quantity
                    << " added to your cart.";
                SetWindowTextA(
                    hMessage,
                    messageText.str().c_str()
                );
                SetWindowTextA(
                    hProduct,
                    ""
                );
                SetWindowTextA(
                    hQuantity,
                    "1"
                );
                if (
                    grandTotal >= 1000 &&
                    creditWon == false
                )
                {
                    CheckCredit(hwnd);
                }
                else if (grandTotal < 1000) {
                    int remaining =
                        1000 - grandTotal;
                    stringstream ss;
                    ss
                        << "You need "
                        << remaining
                        << " EGP more to get 200 EGP Credit.";
                    SetWindowTextA(
                        hMessage,
                        ss.str().c_str()
                    );
                }
                break;
            }
            else if (id == 103) {
                int selected =
                    SendMessageA(
                        hCart,
                        LB_GETCURSEL,
                        0,
                        0
                    );
                if (selected == LB_ERR) {
                    MessageBoxA(
                        hwnd,
                        "Please select an item from your cart first.",
                        "Remove Item",
                        MB_OK | MB_ICONWARNING
                    );
                    break;
                }
                int currentItem = -1;
                int counter = 0;
                for (int i = 0; i < 50; i++) {
                    if (cartQuantity[i] > 0) {
                        if (counter == selected) {
                            currentItem = i;
                            break;
                        }
                        counter++;
                    }
                }
                if (currentItem == -1) {
                    break;
                }
                int removedPrice =
                    prices[currentItem] *
                    cartQuantity[currentItem];
                grandTotal -= removedPrice;
                cartQuantity[currentItem] = 0;
                UpdateCart();
                UpdateTotal();
                stringstream ss;
                ss
                    << products[currentItem]
                    << " removed from your cart.";
                SetWindowTextA(
                    hMessage,
                    ss.str().c_str()
                );
                break;
            }
            else if (id == 102) {
                int answer =
                    MessageBoxA(
                        hwnd,
                        "Are you sure you want to clear your cart?",
                        "Clear Cart",
                        MB_YESNO | MB_ICONQUESTION
                    );
                if (answer == IDYES) {
                    for (int i = 0; i < 50; i++) {
                        cartQuantity[i] = 0;
                    }
                    grandTotal = 0;
                    creditWon = false;
                    UpdateCart();
                    UpdateTotal();
                    SetWindowTextA(
                        hMessage,
                        "Your cart has been cleared.\n"
                        "Start a new shopping session!"
                    );
                    SetWindowTextA(
                        hProduct,
                        ""
                    );
                    SetWindowTextA(
                        hQuantity,
                        "1"
                    );
                }
                break;
            }
            else if (id == 101) {
                if (grandTotal == 0) {
                    MessageBoxA(
                        hwnd,
                        "Your cart is empty!\n"
                        "Please add some products first.",
                        "Empty Cart",
                        MB_OK | MB_ICONWARNING
                    );
                    break;
                }
                if (grandTotal < 1000) {
                    int remaining =
                        1000 - grandTotal;
                    stringstream question;
                    question
                        << "Your total is "
                        << grandTotal
                        << " EGP.\n\n"
                        << "You need "
                        << remaining
                        << " EGP more to get 200 EGP Credit.\n\n"
                        << "Do you want to continue shopping?";
                    int answer =
                        MessageBoxA(
                            hwnd,
                            question.str().c_str(),
                            "Continue Shopping?",
                            MB_YESNO | MB_ICONQUESTION
                        );
                    if (answer == IDYES) {
                        SetWindowTextA(
                            hMessage,
                            "Continue shopping to get 200 EGP Credit!"
                        );
                        SetFocus(hList);
                        break;
                    }
                }
                char name[200];
                char address[300];
                GetWindowTextA(
                    hName,
                    name,
                    200
                );
                GetWindowTextA(
                    hAddress,
                    address,
                    300
                );
                if (name[0] == '\0') {
                    MessageBoxA(
                        hwnd,
                        "Please enter your name.",
                        "Missing Information",
                        MB_OK | MB_ICONWARNING
                    );
                    SetFocus(hName);
                    break;
                }
                if (address[0] == '\0') {
                    MessageBoxA(
                        hwnd,
                        "Please enter your address.",
                        "Missing Information",
                        MB_OK | MB_ICONWARNING
                    );
                    SetFocus(hAddress);
                    break;
                }
                string creditMessage;
                if (grandTotal >= 1000) {
                    creditMessage =
                        "\n\nCongratulations!\n"
                        "You won 200 EGP Credit!";
                }
                else
                {
                    creditMessage =
                        "\n\nYou did not reach 1000 EGP.";
                }
                stringstream order;
                order
                    << "Thank you, "
                    << name
                    << "!\n\n"
                    << "Your order has been successfully placed.\n\n"
                    << "Total: "
                    << grandTotal
                    << " EGP"
                    << creditMessage
                    << "\n\n"
                    << "Your order will be delivered to:\n"
                    << address
                    << "\n\n"
                    << "Thank you for shopping with us!";
                MessageBoxA(
                    hwnd,
                    order.str().c_str(),
                    "Order Confirmed",
                    MB_OK | MB_ICONINFORMATION
                );
                SetWindowTextA(
                    hMessage,
                    "Thank you! Your order will be delivered to your address."
                );
                break;
            }
            break;
        }
        case WM_ERASEBKGND: {
            HDC hdc =
                (HDC)wp;
            RECT rect;
            GetClientRect(
                hwnd,
                &rect
            );
            HBRUSH brush =
                CreateSolidBrush(
                    BG_COLOR
                );
            FillRect(
                hdc,
                &rect,
                brush
            );
            DeleteObject(brush);
            return 1;
        }
        case WM_CTLCOLORSTATIC: {
            HDC hdc =
                (HDC)wp;
            HWND control =
                (HWND)lp;
            SetBkMode(
                hdc,
                TRANSPARENT
            );
            if (control == hTotal) {
                SetTextColor(
                    hdc,
                    GOLD_COLOR
                );
                SetBkColor(
                    hdc,
                    PURPLE_COLOR
                );
                static HBRUSH totalBrush =
                    CreateSolidBrush(
                        PURPLE_COLOR
                    );
                return (LRESULT)totalBrush;
            }
            if (control == hMessage) {
                SetTextColor(
                    hdc,
                    CYAN_COLOR
                );
                SetBkColor(
                    hdc,
                    BG_COLOR
                );
                static HBRUSH messageBrush =
                    CreateSolidBrush(
                        BG_COLOR
                    );
                return (LRESULT)messageBrush;
            }
            SetTextColor(
                hdc,
                WHITE_COLOR
            );
            SetBkColor(
                hdc,
                BG_COLOR
            );
            static HBRUSH labelBrush =
                CreateSolidBrush(
                    BG_COLOR
                );
            return (LRESULT)labelBrush;
        }
        case WM_CTLCOLOREDIT: {
            HDC hdc =
                (HDC)wp;
            SetTextColor(
                hdc,
                DARK_TEXT
            );
            SetBkColor(
                hdc,
                INPUT_COLOR
            );
            static HBRUSH editBrush =
                CreateSolidBrush(
                    INPUT_COLOR
                );
            return (LRESULT)editBrush;
        }
        case WM_CTLCOLORLISTBOX: {
            HDC hdc =
                (HDC)wp;
            SetTextColor(
                hdc,
                DARK_TEXT
            );
            SetBkColor(
                hdc,
                INPUT_COLOR
            );
            static HBRUSH listBrush =
                CreateSolidBrush(
                    INPUT_COLOR
                );
            return (LRESULT)listBrush;
        }
        case WM_CTLCOLORBTN: {
            HDC hdc =
                (HDC)wp;
            HWND button =
                (HWND)lp;
            SetTextColor(
                hdc,
                WHITE_COLOR
            );
            SetBkMode(
                hdc,
                OPAQUE
            );
            if (GetDlgCtrlID(button) == 100) {
                SetBkColor(
                    hdc,
                    GREEN_COLOR
                );
                static HBRUSH addBrush =
                    CreateSolidBrush(
                        GREEN_COLOR
                    );
                return (LRESULT)addBrush;
            }
            if (GetDlgCtrlID(button) == 101) {
                SetBkColor(
                    hdc,
                    BLUE_COLOR
                );

                static HBRUSH checkoutBrush =
                    CreateSolidBrush(
                        BLUE_COLOR
                    );

                return (LRESULT)checkoutBrush;
            }
            if (GetDlgCtrlID(button) == 102) {
                SetBkColor(
                    hdc,
                    RED_COLOR
                );
                static HBRUSH clearBrush =
                    CreateSolidBrush(
                        RED_COLOR
                    );
                return (LRESULT)clearBrush;
            }
            if (GetDlgCtrlID(button) == 103) {
                SetBkColor(
                    hdc,
                    PINK_COLOR
                );
                static HBRUSH removeBrush =
                    CreateSolidBrush(
                        PINK_COLOR
                    );
                return (LRESULT)removeBrush;
            }
            return 0;
        }
        case WM_DESTROY:{
            PostQuitMessage(0);
            break;
        }
        default: {
            return DefWindowProcA(
                hwnd,
                message,
                wp,
                lp
            );
        }
    }
    return 0;
}
int WINAPI WinMain(
    HINSTANCE hInstance,
    HINSTANCE hPrevInstance,
    LPSTR lpCmdLine,
    int nCmdShow
)
{
    WNDCLASSA wc = {};
    wc.hInstance =
        hInstance;

    wc.lpfnWndProc =
        WindowProcedure;
    wc.lpszClassName =
        "SupermarketGUI";
    wc.hCursor =
        LoadCursor(
            NULL,
            IDC_ARROW
        );
    wc.hbrBackground =
        CreateSolidBrush(
            BG_COLOR
        );
    RegisterClassA(
        &wc
    );
    HWND hwnd =
        CreateWindowA(
            "SupermarketGUI",
            "Supermarket Weshweshny",
            WS_OVERLAPPED |
            WS_CAPTION |
            WS_SYSMENU |
            WS_MINIMIZEBOX,
            100,
            50,
            820,
            780,
            NULL,
            NULL,
            hInstance,
            NULL
        );
    if (hwnd == NULL) {
        return 0;
    }
    ShowWindow(
        hwnd,
        nCmdShow
    );
    UpdateWindow(
        hwnd
    );
    MSG msg;
    while (
        GetMessageA(
            &msg,
            NULL,
            0,
            0
        )
    )
    {
        TranslateMessage(
            &msg
        );
        DispatchMessageA(
            &msg
        );
    }
    return 0;
}